APP_NAME="ARENA X"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Локальная демонстрация на MacBook — SQLite, не требует интернета или пароля БД.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"

# Для подключения к Supabase вместо SQLite задайте:
# DB_CONNECTION=pgsql
# DB_HOST=ВАШ_DB_HOST
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=ВАШ_ПАРОЛЬ
# DB_SSLMODE=require
